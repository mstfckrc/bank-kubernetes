# Yerel sertifika/anahtar dosyaları. Public CA sertifikası aşağıda istisnadır.
*.crt
*.key
*.pem

# IDE ve İşletim Sistemi Kalıntıları
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Log ve Test Dosyaları
*.log
__pycache__/
*.py[cod]

# Uygulamanın public CA sertifikası (özel anahtar değil).
!config/root-ca.pem

# Gerçek değer içeren yerel Kubernetes Secret dosyaları.
# Örnek şablonlar (.example.yaml) Git'te kalır.
/config/bank-demo-secrets.yaml
/config/grafana-secret.yaml
/config/tls-secrets.yaml
