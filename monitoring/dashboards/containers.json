{
  "id": null,
  "uid": "bank-demo-containers",
  "title": "Bank-Demo Kubernetes Pods",
  "description": "Docker Compose konteynerlerinin cAdvisor CPU, bellek, önbellek ve ağ metrikleri.",
  "tags": [
    "bank-demo",
    "compose",
    "cadvisor"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bank-demo-prometheus"
        },
        "definition": "label_values(container_last_seen{job=\"cadvisor\"}, instance)",
        "query": {
          "query": "label_values(container_last_seen{job=\"cadvisor\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": []
      },
      {
        "name": "container",
        "label": "Konteyner",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bank-demo-prometheus"
        },
        "definition": "label_values(container_last_seen{job=\"cadvisor\",instance=~\"${instance:regex}\"}, pod)",
        "query": {
          "query": "label_values(container_last_seen{job=\"cadvisor\",instance=~\"${instance:regex}\"}, pod)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Konteyner CPU kullanımı",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bank-demo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "bank-demo-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(pod) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",instance=~\"${instance:regex}\",pod=~\"${container:regex}\"}[5m])) * 100",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Konteyner çalışma belleği",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bank-demo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
