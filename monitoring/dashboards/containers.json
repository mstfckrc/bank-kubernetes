      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "bank-demo-prometheus"
          },
          "editorMode": "code",
          "expr": "container_memory_working_set_bytes{job=\"cadvisor\",instance=~\"${instance:regex}\",pod=~\"${container:regex}\"}",
          "legendFormat": "{{name}}",
          "range": true
